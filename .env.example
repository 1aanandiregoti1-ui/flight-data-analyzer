# Copy this file to .env and fill in your OpenSky API client credentials.
# Create them at https://opensky-network.org  ->  Account  ->  API client.
# .env is listed in .gitignore — never commit it.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional: default bounding box as lamin,lomin,lamax,lomax (degrees).
# Keep it at or under 25 square degrees so each poll costs 1 credit.
# Default below is the US Northeast corridor (NYC / Philadelphia / Boston), 15 sq deg.
# Western Europe alternative (2 credits): 48,-1,53,8
OPENSKY_BBOX=39.5,-76.0,42.5,-71.0
